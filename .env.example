# Adhara workspace this site is wired to.
ADHARA_BASE_URL=https://api.adharaweb.com
ADHARA_WORKSPACE_ID=your-workspace-slug-or-id

# Server-to-server API key (Dashboard → Settings → API Keys). Used for the
# contact form, survey, and join/checkout routes — not for portal customer
# login/signup, which authenticates as the customer instead.
ADHARA_API_KEY=adhara_pk_xxxxxxxxxxxxxxxxxxxxxxxx

# Adhara Contact Us form ID, used as a lead-capture backup in app/api/join.
ADHARA_CONTACT_FORM_ID=

# Stripe price ID for the Founding Membership, used to start checkout in app/api/join.
ADHARA_MEMBERSHIP_PRICE_ID=
